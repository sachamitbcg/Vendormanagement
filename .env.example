# Copy this file to backend/.env and fill in the values.
# NEVER commit a real key.

# --- LLM (Anthropic Claude) ---
# If this is unset, the app still runs: the screening falls back to the
# rule-based findings and the UI shows a "AI unavailable" banner (design 3.2 / 6.4).
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-8
LLM_TIMEOUT_SECONDS=30

# --- Auth ---
# Used to sign JWT session tokens. Change this to any random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Database ---
# SQLite file, relative to the backend/ directory. Alembic manages the schema.
DATABASE_URL=sqlite:///./financeos.db

# --- Demo login accounts (seeded by seed.py) ---
# analyst@financeos.demo / demo1234   (role: analyst  — submits vendors)
# reviewer@financeos.demo / demo1234  (role: reviewer — approves / overrides)
