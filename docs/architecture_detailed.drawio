<mxfile host="Electron">
  <diagram name="FinanceOS Architecture" id="finops-arch">
    <mxGraphModel dx="1013" dy="596" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0A2540;" value="FinanceOS — Solution Architecture" vertex="1">
          <mxGeometry height="34" width="1180" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5D70;" value="Process 3: Vendor Risk &amp; Onboarding Screener · React SPA + FastAPI + SQLite · Anthropic Claude · runs locally" vertex="1">
          <mxGeometry height="22" width="1180" x="40" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#EEF2F7;strokeColor=#C3CFDD;fontColor=#5A6C7E;" value="1 · PEOPLE  —  who uses this" vertex="1">
          <mxGeometry height="110" width="1185" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#8FA3B8;" value="&lt;b&gt;Procurement Analyst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;submits new vendors for screening&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="250" x="90" y="118" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#8FA3B8;" value="&lt;b&gt;Finance Reviewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;approves, or overrides the AI tier&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="250" x="370" y="118" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C7E;verticalAlign=middle;" value="Username and password login. Two roles held on the user record: analyst (submit) and reviewer (approve or override). No single sign-on — out of scope." vertex="1">
          <mxGeometry height="56" width="560" x="650" y="118" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#E8F1FB;strokeColor=#9EC0E4;fontColor=#2E6DB4;" value="2 · FRONTEND  —  the five screens a Finance user sees in the browser" vertex="1">
          <mxGeometry height="150" width="1185" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E6DB4;" value="&lt;b&gt;Login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;email + password&lt;br&gt;holds session token&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="210" x="90" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E6DB4;" value="&lt;b&gt;Vendor Onboarding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;name, ABN, bank account, contact, category&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="210" x="320" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E6DB4;strokeWidth=2.5;" value="&lt;b&gt;Screening Result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;tier, anomalies, rationale, what to verify, override&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="210" x="550" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E6DB4;" value="&lt;b&gt;Vendor Master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;all vendors, risk tier, onboarding status&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="210" x="780" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E6DB4;" value="&lt;b&gt;Eval Log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;AI tier vs human tier, override rate&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="210" x="1010" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#E9F5EE;strokeColor=#8FC9A8;fontColor=#2E7D53;" value="3 · BACKEND  —  the API layer" vertex="1">
          <mxGeometry height="290" width="1185" x="40" y="380" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D53;" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;issues + verifies the login token, hashes passwords, checks role&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="210" x="90" y="435" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D53;" value="&lt;b&gt;Vendor API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;create a vendor, update its status, list vendors and evals&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="210" x="320" y="435" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D53;strokeWidth=2.5;" value="&lt;b&gt;Screening Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#2E7D53;font-weight:bold&quot;&gt;rules, not AI — two checks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;duplicates: ABN, bank, partial&lt;br&gt;completeness: fields + formats&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="210" x="550" y="435" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D53;" value="&lt;b&gt;Audit Logger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;records every AI decision and every human override&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="210" x="780" y="435" as="geometry" />
        </mxCell>
        <mxCell id="n19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#2E7D53;strokeWidth=2.5;" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;builds the prompt, calls Claude, validates the JSON, retries, falls back&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="210" x="1010" y="435" as="geometry" />
        </mxCell>
        <mxCell id="n20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;fillColor=#FFF9E6;strokeColor=#C79A20;fontColor=#8A6A10;" value="&lt;b&gt;/prompts/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;vendor_screening.md (versioned)&lt;/font&gt;" vertex="1">
          <mxGeometry height="58" width="210" x="1010" y="545" as="geometry" />
        </mxCell>
        <mxCell id="n21" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C6B50;" value="&lt;b style=&quot;color:#2E7D53&quot;&gt;Order matters: rules run first, then the LLM explains.&lt;/b&gt;&lt;br&gt;A duplicate is a database fact, not the model&#39;s opinion. The LLM turns those facts into a tier, a rationale and a reviewer checklist — so the demo stays deterministic and auditable.&lt;br&gt;&lt;br&gt;Pydantic validates the form AND the LLM JSON." vertex="1">
          <mxGeometry height="110" width="700" x="90" y="545" as="geometry" />
        </mxCell>
        <mxCell id="n22" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#FDF1E3;strokeColor=#E0B378;fontColor=#B0701F;" value="4 · DATA  —  SQLite file database, Alembic migrations (drop and recreate cleanly)" vertex="1">
          <mxGeometry height="300" width="1185" x="40" y="690" as="geometry" />
        </mxCell>
        <mxCell id="n23" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0A2540;strokeColor=#B0701F;" value="users&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:10px;font-weight:normal&quot;&gt;PK&amp;nbsp; id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; email&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; password_hash&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; role&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; created_at&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;font-weight:normal;color:#8A6A10&quot;&gt;Two seeded accounts, one per role, so the override step can be demoed end to end.&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="250" x="140" y="722" as="geometry" />
        </mxCell>
        <mxCell id="n24" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0A2540;strokeColor=#B0701F;strokeWidth=2.5;" value="vendors&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:10px;font-weight:normal&quot;&gt;PK&amp;nbsp; id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; name&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; abn (indexed)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; bank_account (indexed)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; contact&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; category&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; onboarding_status&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; risk_tier &amp;nbsp;&amp;nbsp;&amp;nbsp;AI&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; screening_notes AI&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ai_rationale AI&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1E6B3A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; human_override human&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; created_at&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="250" x="550" y="722" as="geometry" />
        </mxCell>
        <mxCell id="n25" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0A2540;strokeColor=#B0701F;" value="audit_log&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:10px;font-weight:normal&quot;&gt;PK&amp;nbsp; id&lt;br&gt;FK&amp;nbsp; user_id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; entity_type&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; entity_id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; action&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; old_value&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; new_value&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; timestamp&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-style:italic;color:#8A6A10&quot;&gt;entity_type / entity_id point at vendors.id — polymorphic, no FK.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#8A6A10&quot;&gt;Feeds the Eval Log screen; override rate comes from here.&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="250" x="850" y="722" as="geometry" />
        </mxCell>
        <mxCell id="n27" edge="1" parent="1" source="n23" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;strokeColor=#7A8794;endArrow=open;fontSize=9;labelBackgroundColor=#FDF1E3;" target="n25" value="FK user_id · 1..N (who did it)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fillColor=#F3EDFA;strokeColor=#B49BD8;fontColor=#6B4FA8;" value="5 · EXTERNAL SERVICES &amp; HOSTING" vertex="1">
          <mxGeometry height="180" width="455" x="1265" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;strokeColor=#6B4FA8;strokeWidth=2.5;" value="&lt;b&gt;Anthropic Claude API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;HTTPS · key read from .env · never committed&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="405" x="1290" y="117" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#54407F;" value="Hosting, storage and auth are all local: uvicorn serves the API, vite serves the UI, SQLite is a file on disk, login is in-app. No queue — one synchronous LLM call, ~2-4s, behind a loading state." vertex="1">
          <mxGeometry height="70" width="420" x="1285" y="180" as="geometry" />
        </mxCell>
        <mxCell id="n31" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#6B4FA8;fontColor=#2E4A63;" value="&lt;b style=&quot;color:#6B4FA8;font-size:13px&quot;&gt;LLM CALL CONTRACT — steps 5 to 7&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;WHAT GOES IN&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:9.5px&quot;&gt;system: role = finance compliance screener;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; tiering rules; output schema;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; never invent facts not supplied&lt;br&gt;user: &amp;nbsp;&amp;nbsp; the vendor form + the rule findings&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;WHAT COMES BACK — JSON, schema-validated&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:9.5px&quot;&gt;{ risk_tier &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Low | Medium | High&lt;br&gt;&amp;nbsp; anomalies &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; [string]&lt;br&gt;&amp;nbsp; verify_checklist [string]&lt;br&gt;&amp;nbsp; rationale &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; string }&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;WHERE EACH FIELD LANDS&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:9.5px&quot;&gt;risk_tier -&gt; vendors.risk_tier&lt;br&gt;anomalies + verify_checklist -&gt; vendors.screening_notes&lt;br&gt;rationale -&gt; vendors.ai_rationale&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;font-style:italic;color:#5A6C7E&quot;&gt;Every field returned is a field stored. Nothing is discarded.&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="455" x="1265" y="278" as="geometry" />
        </mxCell>
        <mxCell id="n32" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#F7F9FB;strokeColor=#C3CFDD;fontColor=#0A2540;fontColor=#2E4A63;fontSize=10.5;" value="&lt;b style=&quot;font-size:13px&quot;&gt;DATA FLOW — follow the numbered arrows&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Analyst signs in; token issued, carrying their role.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Fills the onboarding form. (Happens in the browser.)&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Form posted to the API; fields and formats validated.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Screening Engine queries vendors for duplicates: exact ABN, exact bank, partial match.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Findings + form go to the Gateway, which loads the prompt.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; HTTPS call to Claude (system + user messages).&lt;br&gt;&lt;b&gt;7&lt;/b&gt; JSON reply validated, then written to the vendors row. (Inside the Gateway.)&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Result card shows tier, anomalies, verify list, rationale.&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Reviewer approves, or overrides the tier and says why. The human gate.&lt;br&gt;&lt;b&gt;10&lt;/b&gt; Audit Logger records the AI decision and the override.&lt;br&gt;&lt;b&gt;11&lt;/b&gt; Vendor Master and Eval Log read back from the database." vertex="1">
          <mxGeometry height="320" width="455" x="1265" y="594" as="geometry" />
        </mxCell>
        <mxCell id="n33" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#FDF0EE;strokeColor=#C0392B;fontColor=#C0392B;strokeWidth=2;fontColor=#8C2E22;fontSize=10.5;" value="&lt;b style=&quot;color:#C0392B;font-size:13px&quot;&gt;FALLBACK PATH — when the model call fails&lt;/b&gt;&lt;br&gt;Trigger: timeout, rate limit, malformed or invalid JSON&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; One retry with backoff.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Serve the rule findings on their own.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Banner: “AI summary unavailable — the checks below are rule-based. Please review manually.”&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Status stays pending. Nothing is ever auto-approved.&lt;br&gt;&lt;i&gt;The screen degrades. It never blanks.&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="455" x="1265" y="930" as="geometry" />
        </mxCell>
        <mxCell id="n34" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#F7F9FB;strokeColor=#C3CFDD;fontColor=#0A2540;fontColor=#2E4A63;" value="&lt;b style=&quot;font-size:13px&quot;&gt;HOW TO READ THIS DIAGRAM&lt;/b&gt;&lt;br&gt;&lt;br&gt;A number on an arrow = data moving between components.&lt;br&gt;A caption under a box (e.g. &lt;i&gt;step 2&lt;/i&gt;) = the step happens inside it.&lt;br&gt;Dashed = reading data back, not a new action.&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;AI&lt;/font&gt; = the model writes this column · &lt;font color=&quot;#1E6B3A&quot;&gt;human&lt;/font&gt; = a person does.&lt;br&gt;Heavy border = the three parts the live demo hinges on.&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;PK/FK = primary/foreign key · 1..N = one row links to many rows&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="455" x="1265" y="1128" as="geometry" />
        </mxCell>
        <mxCell id="n35" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#F4F5F7;strokeColor=#B8BFC7;fontColor=#7A8794;dashed=1;fontColor=#6B7783;fontSize=10;" value="&lt;b style=&quot;font-size:12px;color:#5A6C7E&quot;&gt;SCOPE — WHAT IS NOT BUILT, AND WHY&lt;/b&gt;&lt;br&gt;· Sanctions screening. Named in the brief, but Appendix A supplies no watchlist. Flagged as outstanding on the reviewer checklist instead.&lt;br&gt;· Processes 1 and 2 — schema exists, UI does not.&lt;br&gt;· No SSO, mobile layouts, multi-tenancy, CI/CD or async queue." vertex="1">
          <mxGeometry height="126" width="455" x="1265" y="1288" as="geometry" />
        </mxCell>
        <mxCell id="n36" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#F7F9FB;strokeColor=#C3CFDD;fontColor=#0A2540;fontColor=#2E4A63;" value="&lt;b style=&quot;font-size:13px&quot;&gt;REPOSITORY LAYOUT (Deliverable 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:10px&quot;&gt;/README.md &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; setup, env vars, seed, run&lt;br&gt;/docs/architecture.png &amp;nbsp;&amp;nbsp;&amp;nbsp; this diagram&lt;br&gt;/docs/design-decisions.md &amp;nbsp; 3-5 decisions + trade-offs&lt;br&gt;/prompts/vendor_screening.md&lt;br&gt;/src/api/ &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; routes, auth, request schemas&lt;br&gt;/src/screening/ &amp;nbsp; duplicate + completeness rules&lt;br&gt;/src/llm/ &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; gateway, retry, JSON validation&lt;br&gt;/src/db/ &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; models, alembic/, seed (25 vendors)&lt;br&gt;/src/web/ &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; React SPA&lt;br&gt;/.env.example &amp;nbsp;&amp;nbsp;&amp;nbsp; ANTHROPIC_API_KEY=&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;A reviewer should get from clone to running app in four commands:&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size:10px&quot;&gt;cp .env.example .env · alembic upgrade head · seed · run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5A6C7E&quot;&gt;Public repo, link shared at least 24 hours before the interview slot. Migrations are repeatable — drop, re-run, reseed, same state.&lt;/font&gt;" vertex="1">
          <mxGeometry height="340" width="570" x="40" y="990" as="geometry" />
        </mxCell>
        <mxCell id="n37" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fillColor=#F7F9FB;strokeColor=#C3CFDD;fontColor=#0A2540;fontColor=#2E4A63;" value="&lt;b style=&quot;font-size:13px&quot;&gt;DESIGN PRINCIPLES → WHERE THEY LIVE IN THIS DESIGN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2E7D53&quot;&gt;Business-first design&lt;/b&gt;&lt;br&gt;The UI says “Approve vendor”, never an endpoint name. The default state is the most common action, not the easiest one to code.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2E7D53&quot;&gt;AI assists, it never decides&lt;/b&gt;&lt;br&gt;The tier is always overridable. The rationale sits beside every recommendation. Every decision and every override is logged.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2E7D53&quot;&gt;Prompt engineering discipline&lt;/b&gt;&lt;br&gt;Prompts live in /prompts/, system + user pattern, JSON schema out. Edge cases already sit in the seed data.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2E7D53&quot;&gt;Reliability over cleverness&lt;/b&gt;&lt;br&gt;Loading and empty states throughout. One synchronous model call, ~2-4s, with the fallback path alongside.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#2E7D53&quot;&gt;Scope discipline&lt;/b&gt;&lt;br&gt;Two checks built properly rather than three built thinly. Every omission is a recorded decision." vertex="1">
          <mxGeometry height="340" width="585" x="640" y="990" as="geometry" />
        </mxCell>
        <mxCell id="n38" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A97A5;" value="FinanceOS technical assessment · Process 3 of 3 · every layer runs on the presenter&#39;s machine · seed data: 25 vendors including 3 exact duplicates and 2 partial duplicates" vertex="1">
          <mxGeometry height="20" width="1680" x="40" y="1350" as="geometry" />
        </mxCell>
